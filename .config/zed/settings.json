// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
    // --------------------------- general --------------------------- //
    "accessible_mode": false,
    "cli_default_open_behavior": "new_window",
    "tabs": {
        "close_position": "left",
    },
    "helix_mode": false,
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "git_panel": {
        "tree_view": false,
        "dock": "left",
    },
    "profiles": {
        "big_screen_mode": {
            "settings": {
                "ui_font_size": 14,
                "buffer_font_size": 14,
                "agent_buffer_font_size": 14,
                "agent_ui_font_size": 16,
                "markdown_preview": {
                    "font_size": 16,
                }
            },
        },
    },
    // --------------------------- UI & appearance --------------------------- //
    // font
    "buffer_font_size": 12,
    "agent_buffer_font_size": 10.0,
    // "agent_ui_font_size": 14,
    "ui_font_size": 12,
    "ui_font_family": "JetBrainsMono Nerd Font",
    "ui_font_weight": 600,
    "buffer_line_height": "comfortable",

    // // jetbrains settings
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "buffer_font_weight": 500,
    "buffer_font_features": {
        "calt": true,
        "ss02": true,
        "zero": true,
    },

    // // cascadia code settings
    // "buffer_font_family": "CaskaydiaCove Nerd Font Mono",
    // "buffer_font_features": {
    //     "calt": true,
    //     "ss01": true,
    //     "ss02": true,
    //     "ss03": true,
    //     "ss20": true,
    //     "zero": true,
    // },

    // 0xProto settings
    // "buffer_font_family": "0xProto Nerd Font",
    // "buffer_font_features": {
    //     "ss01": true,
    // },

    // markdown
    "markdown_preview": {
        // "font_family": "Libron",
    },

    // ui
    "icon_theme": "Monospace Icon Theme - Dark",
    "theme": "Rosé Pine Dawn",
    "tab_bar": {
        "show_nav_history_buttons": false,
    },
    "active_pane_modifiers": {
        "border_size": 1,
    },
    "scrollbar": {
        // "diagnostics": "none",
        "git_diff": true,
        "show": "auto",
    },
    "soft_wrap": "editor_width",
    "show_whitespaces": "boundary",
    "wrap_guides": [88],
    "indent_guides": {
        "active_line_width": 2,
    },
    "project_panel": {
        "dock": "left",
        "indent_size": 16,
        "sticky_scroll": false,
    },
    "zoomed_padding": false,
    "which_key": {
        "enabled": true,
        "delay_ms": 100,
    },
    "experimental.theme_overrides": {
        "syntax": {
            "comment": {
                "font_style": "italic",
            },
            "keyword": {
                "font_style": "italic",
                "font_weight": 600,
            },
            "type": {
                "font_weight": 600,
            },
            "variable.special": {
                "font_style": "italic",
                "font_weight": 600,
            },
        },
        // "predictive": "#666", // change suggestion color
    },
    // ------------------------------ editor ------------------------------ //
    "vim_mode": true,
    // "helix_mode": true,
    // "relative_line_numbers": "enabled",
    // "vertical_scroll_margin": 999, // keep cursor at center
    "tab_size": 4,
    "hard_tabs": false,
    "show_completions_on_input": true,
    "always_treat_brackets_as_autoclosed": true,
    // ------------------------ formatter & linter ------------------------ //
    "file_types": {
        "XML": ["csproj", "vcxproj"],
        "shell": ["*rc"],
        "json": [".prettierrc"],
        "yaml": ["config"],
    },
    "format_on_save": "off",
    "ensure_final_newline_on_save": false,
    "remove_trailing_whitespace_on_save": false,
    "languages": {
        "Python": {
            "show_edit_predictions": true,
            "language_servers": ["ruff", "ty", "!pyright", "!pyrefly"],
            "formatter": [
                {
                    "code_action": "source.organizeImports.ruff",
                },
                {
                    "code_action": "source.check.ruff",
                },
                {
                    "language_server": {
                        "name": "ruff",
                    },
                },
            ],
            "code_actions_on_format": {
                "source.fixAll.ruff": true,
            },
            "format_on_save": "on",
        },
        "C++": {
            "formatter": {
                "external": {
                    "command": "clang-format",
                    "arguments": [
                        "--assume-filename={buffer_path}",
                        "--style={ BasedOnStyle: LLVM, IndentWidth: 4, TabWidth: 4 }",
                    ],
                },
            },
            "format_on_save": "off",
        },
        "JavaScript": {
            "formatter": {
                "external": {
                    "command": "npx",
                    "arguments": [
                        "prettier",
                        "--stdin-filepath",
                        "{buffer_path}",
                        "--tab-width",
                        "4",
                    ],
                },
            },
        },
        "Make": {
            "hard_tabs": true,
        },
        "Markdown": {
            "show_edit_predictions": false,
            // "format_on_save": "on"
        },
        "Typst": {
            "formatter": {
                "external": {
                    "command": "typstyle",
                    "arguments": [],
                },
            },
            "format_on_save": "on",
        },
        "Java": {
            // "enable_language_server": false,
        },
        "CSharp": {
            // "enable_language_server": false,
            "language_servers": ["!roslyn", "omnisharp"],
        },
        "SQL": {
            "formatter": {
                "external": {
                    "command": "sqlfluff",
                    "arguments": [
                        "fix",
                        "{buffer_path}",
                        "--dialect",
                        "postgres",
                    ],
                },
            },
        },
    },
    "lsp": {
        "ruff": {
            "initialization_options": {
                "settings": {
                    "showSyntaxErrors": true,
                    "lineLength": 88,
                    "lint": {
                        // "select": ["ALL"],
                        // "extendSelect": ["I"],
                        // "ignore": ["F401"]
                    },
                },
            },
        },
        "omnisharp": {
            "settings": {
                "csharp.analysis": {
                    "diagnosticMode": "off",
                    "typeCheckingMode": "off",
                },
            },
        },
        "ty": {
            "binary": {
                "path": ".venv/bin/ty",
                "arguments": ["server"],
            },
        },
        "tinymist": {
            "settings": {
                "exportPdf": "onSave",
                "outputPath": "$dir/$name",
            },
        },
        "rust-analyzer": {
            "initialization_options": {
                "cachePriming": {
                    "enable": false,
                },
            },
        },
    },
    // ---------------------------- terminal ---------------------------- //
    "terminal": {
        "detect_venv": {
            "on": {
                "activate_script": "fish",
            },
        },
        "shell": {
            "with_arguments": {
                "program": "/opt/homebrew/bin/fish",
                "args": ["--login", "--interactive"],
            },
        },
        "blinking": "off",
        "env": {
            "PYTHONPATH": ".",
        },
    },
    // ---------------------------- remote ---------------------------- //
    "ssh_connections": [
        {
            "host": "10.19.16.10",
            "username": "nvh",
            "args": [],
            "projects": [
                {
                    "paths": ["/home/nvh/gitlab/qapi2"],
                },
                {
                    "paths": ["/home/nvh/gitlab/qapi4"],
                },
                {
                    "paths": ["/home/nvh/gitlab/qconfig/./"],
                },
                {
                    "paths": ["/home/nvh/gitlab/qsmis"],
                },
            ],
        },
    ],
    // ---------------------------- AI ---------------------------- //
    "edit_predictions": {
        "open_ai_compatible_api": {
            "api_url": "https://openrouter.ai/api/v1/chat/completions",
            "model": "minimax/minimax-m2.7",
        },
        "provider": "open_ai_compatible_api",
        "mode": "eager",
        "copilot": {
            "proxy": null,
            "proxy_no_verify": null,
        },
    },
    "show_edit_predictions": true,
    "language_models": {},
    "agent": {
        "tool_permissions": {
            "tools": {
                "terminal": {
                    "always_allow": [
                        {
                            "pattern": "^git\\b",
                        },
                        {
                            "pattern": "^tail\\b",
                        },
                    ],
                },
            },
        },
        "dock": "right",
        "inline_assistant_model": {
            "provider": "openrouter",
            "model": "deepseek/deepseek-v4.1-flash",
            "enable_thinking": false,
        },
        "default_model": {
            "effort": "high",
            "provider": "openrouter",
            "model": "deepseek/deepseek-v4.1-flash",
            "enable_thinking": true,
        },
        "favorite_models": [],
        "model_parameters": [],
    },
    "agent_servers": {
        "pi-acp": {
            "default_config_options": {
                "thought_level": "medium",
                "model": "deepseek/deepseek-flash",
            },
            "type": "registry",
        },
        "claude-acp": {
            "type": "registry",
        },
        "auggie": {
            "type": "registry",
        },
        "amp-acp": {
            "type": "registry",
        },
        "opencode": {
            "type": "registry",
        },
    },
    "context_servers": {
        "Astro docs": {
            "settings": {},
            "enabled": true,
            "url": "https://mcp.docs.astro.build/mcp",
        },
    },
    "use_system_prompts": false,
    "use_system_path_prompts": false,
    // ---------------------------- others ---------------------------- //
    // avoid zed to collect data
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "command_aliases": {
        "lsplg": "dev::OpenLanguageServerLogs",
        "lg": "zed::OpenLog",
    },
    "auto_install_extensions": {
        "dracula": true,
        "git-firefly": true,
        "kanagawa-themes": true,
        "rose-pine-theme": true,
        "ruff": true,
    },
    // "auto_update": false,
}
