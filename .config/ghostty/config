# font-family = "0xProto Nerd Font"
font-size = 14
font-family = "JetBrainsMono Nerd Font"
# font-family = "Lantinghei TC"
window-title-font-family = "0xproto Nerd Font Mono"

font-codepoint-map = "U+4E00-U+9FFF,U+3400-U+4DBF = IBM Plex Sans TC Text"
adjust-cell-width = "-10%"
adjust-cell-height = "5%"
adjust-icon-height = "-20%"

window-padding-x = 8
window-padding-y = 4

# background-opacity = 0.85
background-blur = true

window-theme = light
# theme = Kanagawa Dragon
theme = light:"Rose Pine Dawn",dark: "Dracula"

shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false

# custom-shader = shaders/WIP.glsl
# custom-shader = shaders/cursor_frozen.glsl
# custom-shader = shaders/cursor_blaze_tapered.glsl
# custom-shader = shaders/cursor_fire.glsl
# custom-shader = shaders/tft.glsl
custom-shader = shaders/cursor_fire_rev.glsl

command = /opt/homebrew/bin/fish --login --interactive

# macos-non-native-fullscreen = visible-menu
macos-option-as-alt = true
macos-titlebar-style = tabs
macos-icon = xray
macos-window-buttons = hidden

# keybinding #
# negivation
keybind = option+h=goto_split:left
keybind = option+j=goto_split:bottom
keybind = option+k=goto_split:top
keybind = option+l=goto_split:right
keybind = shift+escape=toggle_split_zoom

# keybind = global:ctrl+T=toggle_quick_terminal
# quick-terminal-position = center
# quick-terminal-animation-duration = 0

# shell-integration-features = ssh-env, ssh-terminfo
keybind = shift+enter=text:\x1b\r
